              "concepts/calls",
              "concepts/prospects",
              "concepts/workflows"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/making-your-first-call",
              "guides/managing-prospects",
              "guides/error-handling",
              "webhooks",
              "sdks"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
